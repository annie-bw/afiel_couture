# Afiel Couture, on Apache or LiteSpeed (Hostinger).
#
# This file has to exist. The site is a single-page app: only / is a real file
# on disk, and /products, /services and the rest are routes the JavaScript
# resolves. Without the rewrite below the server looks for a directory named
# "products", does not find one, and returns 404 to anyone who types the address
# or refreshes the page.

# Apache redirects a request for a directory to the same path with a slash
# appended, and it does that before the rewrites below get a say. The deploy left
# an empty fabrics directory behind, so /fabrics still 301'd to /fabrics/ even
# after the photographs moved out of it. Turning the fixup off lets the route
# rules answer /fabrics directly. Nothing here serves a directory listing, so
# there is nothing that needs the slash.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve HTTPS. Hostinger issues the certificate; this makes sure the plain
  # http:// address does not serve a second copy of the site, which search
  # engines would treat as duplicate content.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # One address for the site. www.afielcouture.com served the same pages as
  # afielcouture.com, which is two addresses for one site: search engines have to
  # guess which is canonical, and any ranking earned is split between them. The
  # canonical tag in index.html says the bare domain, so make the server agree.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # The app's own routes resolve to index.html even if a directory of the same
  # name exists. This is not hypothetical: the fabric photographs lived in
  # public/fabrics, so /fabrics matched a real directory, Apache redirected to
  # /fabrics/, found no index file and returned 403. The page was unreachable by
  # URL while internal navigation still worked, which is the kind of fault nobody
  # notices until a search engine crawls it.
  RewriteRule ^(products|fabrics|services|about|contact)(/.*)?$ index.html [L]

  # A real file or directory is served as itself. Everything else is handed to
  # index.html, which is what makes deep links and refreshes work.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Compression. Text assets are roughly a third of their size over the wire.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# Caching. Files under /assets/ carry a content hash in their name, so a new
# build produces a new filename and a year-long cache can never go stale.
#
# Images get the same year, which is only safe because every image URL carries
# ?v=<hash of the file>, added by src/lib/imageUrl.ts from the manifest that
# scripts/fingerprint-images.mjs writes during the build. Replace a photograph
# and its URL changes with it, so nobody is left looking at the old one.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # Images are handled by mod_headers below, where the length of the cache can
  # depend on whether the URL carries a version stamp.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # A year for any image asked for by version, a week for one asked for plainly.
  # The app appends ?v=<hash of the file> to every image it renders, so those are
  # safe to keep forever: replacing the photograph changes the hash, and with it
  # the URL. A bare URL gets the shorter window, because a file like og-image.jpg
  # is fetched by crawlers that never see the stamp and would otherwise be stuck
  # with an old card for a year.
  SetEnvIf Query_String "(^|&)v=[0-9a-f]+" versioned_asset
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|ico|svg)$">
    Header set Cache-Control "public, max-age=604800"
    Header set Cache-Control "public, max-age=31536000, immutable" env=versioned_asset
  </FilesMatch>
  # index.html must never be cached: it is the file that names the current
  # build's assets, so a stale copy points at files that no longer exist.
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Hostinger's Git deployment clones the repository into the web root, which
# leaves a .git directory sitting there. Served over HTTP that hands anyone the
# full history of the site. Refuse it, along with any other dotfile.
RedirectMatch 404 /\.git
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

ErrorDocument 404 /index.html
